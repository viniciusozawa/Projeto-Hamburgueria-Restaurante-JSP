<?xml version="1.0" encoding="UTF-8"?>
<!--
  Relatório 2 - Pratos mais vendidos (JasperReports, formato da versão 6).

  Para que serve: ranking dos pratos do cardápio por quantidade vendida no
  período, com a receita de cada um e quanto ela pesa no total.
  Decisões: o que promover, o que reajustar e o que tirar do cardápio
  (pratos que não venderam nada aparecem em vermelho no fim da lista).

  Entra TODO prato do cardápio, mesmo sem venda: por isso o cardápio é a
  tabela principal e as vendas do período entram por LEFT JOIN.
  "participacao" usa SUM() OVER (), uma função de janela do MySQL 8 que
  soma a coluna inteira sem agrupar as linhas.
-->
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="pratos_mais_vendidos" pageWidth="595" pageHeight="842" columnWidth="535"
              leftMargin="30" rightMargin="30" topMargin="28" bottomMargin="28"
              whenNoDataType="AllSectionsNoDetail">

    <style name="Base" isDefault="true" fontName="DejaVu Sans" fontSize="9" forecolor="#1E2A24"/>
    <style name="Cabecalho" fontName="DejaVu Sans" fontSize="9" isBold="true" forecolor="#123B2E" backcolor="#F3EEE2" mode="Opaque"/>
    <style name="Linha">
        <conditionalStyle>
            <conditionExpression><![CDATA[$F{quantidade}.signum() == 0]]></conditionExpression>
            <style forecolor="#C4341F"/>
        </conditionalStyle>
        <conditionalStyle>
            <conditionExpression><![CDATA[$V{REPORT_COUNT} % 2 == 0]]></conditionExpression>
            <style mode="Opaque" backcolor="#FBF9F4"/>
        </conditionalStyle>
    </style>
    <style name="Total" mode="Opaque" forecolor="#FFFFFF" backcolor="#123B2E" isBold="true"/>

    <parameter name="DATA_INICIO" class="java.sql.Date"/>
    <parameter name="DATA_FIM" class="java.sql.Date"/>
    <parameter name="PERIODO" class="java.lang.String">
        <defaultValueExpression><![CDATA["Todo o período"]]></defaultValueExpression>
    </parameter>

    <queryString language="SQL">
        <![CDATA[
SELECT c.nomeComida                AS prato,
       cat.nomeCategoria           AS categoria,
       c.valorComida               AS preco,
       COALESCE(v.qtd, 0)          AS quantidade,
       COALESCE(v.receita, 0)      AS receita,
       COALESCE(v.receita, 0) / NULLIF(SUM(COALESCE(v.receita, 0)) OVER (), 0) AS participacao
  FROM cardapio c
  JOIN categoria cat ON cat.codCategoria = c.categoria_codCategoria
  LEFT JOIN (SELECT pc.cardapio_codCardapio              AS cod,
                    SUM(pc.quantidade)                   AS qtd,
                    SUM(pc.quantidade * c2.valorComida)  AS receita
               FROM pedido_por_cardapio pc
               JOIN pedido p    ON p.codpedido = pc.pedido_idpedido
               JOIN cardapio c2 ON c2.codCardapio = pc.cardapio_codCardapio
              WHERE ($P{DATA_INICIO} IS NULL OR DATE(p.datahoraPedido) >= $P{DATA_INICIO})
                AND ($P{DATA_FIM}    IS NULL OR DATE(p.datahoraPedido) <= $P{DATA_FIM})
              GROUP BY pc.cardapio_codCardapio) v ON v.cod = c.codCardapio
 ORDER BY quantidade DESC, receita DESC, prato
        ]]>
    </queryString>

    <field name="prato" class="java.lang.String"/>
    <field name="categoria" class="java.lang.String"/>
    <field name="preco" class="java.math.BigDecimal"/>
    <field name="quantidade" class="java.math.BigDecimal"/>
    <field name="receita" class="java.math.BigDecimal"/>
    <field name="participacao" class="java.math.BigDecimal"/>

    <variable name="TOTAL_QTD" class="java.math.BigDecimal" calculation="Sum">
        <variableExpression><![CDATA[$F{quantidade}]]></variableExpression>
        <initialValueExpression><![CDATA[java.math.BigDecimal.ZERO]]></initialValueExpression>
    </variable>
    <variable name="TOTAL_RECEITA" class="java.math.BigDecimal" calculation="Sum">
        <variableExpression><![CDATA[$F{receita}]]></variableExpression>
        <initialValueExpression><![CDATA[java.math.BigDecimal.ZERO]]></initialValueExpression>
    </variable>
    <variable name="SEM_VENDA" class="java.lang.Integer" calculation="Sum">
        <variableExpression><![CDATA[$F{quantidade}.signum() == 0 ? 1 : 0]]></variableExpression>
        <initialValueExpression><![CDATA[0]]></initialValueExpression>
    </variable>
    <!-- o primeiro da lista é o campeão (a ordem vem do SQL) -->
    <variable name="CAMPEAO" class="java.lang.String" calculation="First">
        <variableExpression><![CDATA[$F{prato}]]></variableExpression>
    </variable>

    <title>
        <band height="86">
            <rectangle>
                <reportElement mode="Opaque" x="0" y="0" width="535" height="62" forecolor="#123B2E" backcolor="#123B2E"/>
            </rectangle>
            <staticText>
                <reportElement x="14" y="8" width="300" height="16" forecolor="#E8A317"/>
                <textElement><font size="10" isBold="true"/></textElement>
                <text><![CDATA[BIG TITES · HAMBURGUERIA]]></text>
            </staticText>
            <staticText>
                <reportElement x="14" y="26" width="360" height="26" forecolor="#FFFFFF"/>
                <textElement><font size="18" isBold="true"/></textElement>
                <text><![CDATA[Pratos mais vendidos]]></text>
            </staticText>
            <textField>
                <reportElement x="330" y="10" width="192" height="14" forecolor="#C7D8CE"/>
                <textElement textAlignment="Right"/>
                <textFieldExpression><![CDATA[$P{PERIODO}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="330" y="36" width="192" height="14" forecolor="#C7D8CE"/>
                <textElement textAlignment="Right"><font size="8"/></textElement>
                <textFieldExpression><![CDATA["Gerado em " + new java.text.SimpleDateFormat("dd/MM/yyyy HH:mm").format(new java.util.Date())]]></textFieldExpression>
            </textField>
            <staticText>
                <reportElement x="0" y="68" width="535" height="14" forecolor="#5C6B63"/>
                <textElement><font size="8" isItalic="true"/></textElement>
                <text><![CDATA[Todos os pratos do cardápio, do mais vendido ao menos vendido. Em vermelho: nenhuma venda no período.]]></text>
            </staticText>
        </band>
    </title>

    <columnHeader>
        <band height="22">
            <staticText>
                <reportElement style="Cabecalho" x="0" y="0" width="25" height="22"/>
                <box leftPadding="6"><bottomPen lineWidth="1.5" lineColor="#123B2E"/></box>
                <textElement verticalAlignment="Middle"/>
                <text><![CDATA[#]]></text>
            </staticText>
            <staticText>
                <reportElement style="Cabecalho" x="25" y="0" width="150" height="22"/>
                <box leftPadding="4"><bottomPen lineWidth="1.5" lineColor="#123B2E"/></box>
                <textElement verticalAlignment="Middle"/>
                <text><![CDATA[Prato]]></text>
            </staticText>
            <staticText>
                <reportElement style="Cabecalho" x="175" y="0" width="90" height="22"/>
                <box leftPadding="4"><bottomPen lineWidth="1.5" lineColor="#123B2E"/></box>
                <textElement verticalAlignment="Middle"/>
                <text><![CDATA[Categoria]]></text>
            </staticText>
            <staticText>
                <reportElement style="Cabecalho" x="265" y="0" width="70" height="22"/>
                <box rightPadding="6"><bottomPen lineWidth="1.5" lineColor="#123B2E"/></box>
                <textElement textAlignment="Right" verticalAlignment="Middle"/>
                <text><![CDATA[Preço]]></text>
            </staticText>
            <staticText>
                <reportElement style="Cabecalho" x="335" y="0" width="55" height="22"/>
                <box rightPadding="6"><bottomPen lineWidth="1.5" lineColor="#123B2E"/></box>
                <textElement textAlignment="Right" verticalAlignment="Middle"/>
                <text><![CDATA[Vendidos]]></text>
            </staticText>
            <staticText>
                <reportElement style="Cabecalho" x="390" y="0" width="80" height="22"/>
                <box rightPadding="6"><bottomPen lineWidth="1.5" lineColor="#123B2E"/></box>
                <textElement textAlignment="Right" verticalAlignment="Middle"/>
                <text><![CDATA[Receita]]></text>
            </staticText>
            <staticText>
                <reportElement style="Cabecalho" x="470" y="0" width="65" height="22"/>
                <box rightPadding="6"><bottomPen lineWidth="1.5" lineColor="#123B2E"/></box>
                <textElement textAlignment="Right" verticalAlignment="Middle"/>
                <text><![CDATA[% receita]]></text>
            </staticText>
        </band>
    </columnHeader>

    <detail>
        <band height="18">
            <textField>
                <reportElement style="Linha" x="0" y="0" width="25" height="18"/>
                <box leftPadding="6"><bottomPen lineWidth="0.5" lineColor="#ECE7DB"/></box>
                <textElement verticalAlignment="Middle"><font isBold="true"/></textElement>
                <textFieldExpression><![CDATA[$V{REPORT_COUNT}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement style="Linha" x="25" y="0" width="150" height="18"/>
                <box leftPadding="4"><bottomPen lineWidth="0.5" lineColor="#ECE7DB"/></box>
                <textElement verticalAlignment="Middle"/>
                <textFieldExpression><![CDATA[$F{prato}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement style="Linha" x="175" y="0" width="90" height="18"/>
                <box leftPadding="4"><bottomPen lineWidth="0.5" lineColor="#ECE7DB"/></box>
                <textElement verticalAlignment="Middle"/>
                <textFieldExpression><![CDATA[$F{categoria}]]></textFieldExpression>
            </textField>
            <textField pattern="R$ #,##0.00">
                <reportElement style="Linha" x="265" y="0" width="70" height="18"/>
                <box rightPadding="6"><bottomPen lineWidth="0.5" lineColor="#ECE7DB"/></box>
                <textElement textAlignment="Right" verticalAlignment="Middle"/>
                <textFieldExpression><![CDATA[$F{preco}]]></textFieldExpression>
            </textField>
            <textField pattern="#,##0">
                <reportElement style="Linha" x="335" y="0" width="55" height="18"/>
                <box rightPadding="6"><bottomPen lineWidth="0.5" lineColor="#ECE7DB"/></box>
                <textElement textAlignment="Right" verticalAlignment="Middle"><font isBold="true"/></textElement>
                <textFieldExpression><![CDATA[$F{quantidade}]]></textFieldExpression>
            </textField>
            <textField pattern="R$ #,##0.00">
                <reportElement style="Linha" x="390" y="0" width="80" height="18"/>
                <box rightPadding="6"><bottomPen lineWidth="0.5" lineColor="#ECE7DB"/></box>
                <textElement textAlignment="Right" verticalAlignment="Middle"/>
                <textFieldExpression><![CDATA[$F{receita}]]></textFieldExpression>
            </textField>
            <textField pattern="0.0%" isBlankWhenNull="true">
                <reportElement style="Linha" x="470" y="0" width="65" height="18"/>
                <box rightPadding="6"><bottomPen lineWidth="0.5" lineColor="#ECE7DB"/></box>
                <textElement textAlignment="Right" verticalAlignment="Middle"/>
                <textFieldExpression><![CDATA[$F{participacao}]]></textFieldExpression>
            </textField>
        </band>
    </detail>

    <pageFooter>
        <band height="20">
            <staticText>
                <reportElement x="0" y="4" width="300" height="14" forecolor="#93AA9C"/>
                <textElement><font size="7"/></textElement>
                <text><![CDATA[Big Tites · relatório gerado pelo sistema]]></text>
            </staticText>
            <textField>
                <reportElement x="395" y="4" width="100" height="14" forecolor="#93AA9C"/>
                <textElement textAlignment="Right"><font size="7"/></textElement>
                <textFieldExpression><![CDATA["Página " + $V{PAGE_NUMBER} + " de"]]></textFieldExpression>
            </textField>
            <textField evaluationTime="Report">
                <reportElement x="495" y="4" width="40" height="14" forecolor="#93AA9C"/>
                <textElement><font size="7"/></textElement>
                <textFieldExpression><![CDATA[" " + $V{PAGE_NUMBER}]]></textFieldExpression>
            </textField>
        </band>
    </pageFooter>

    <summary>
        <band height="340">
            <staticText>
                <reportElement style="Total" x="0" y="0" width="335" height="22"/>
                <box leftPadding="6"/>
                <textElement verticalAlignment="Middle"/>
                <text><![CDATA[Total]]></text>
            </staticText>
            <textField pattern="#,##0">
                <reportElement style="Total" x="335" y="0" width="55" height="22"/>
                <box rightPadding="6"/>
                <textElement textAlignment="Right" verticalAlignment="Middle"/>
                <textFieldExpression><![CDATA[$V{TOTAL_QTD}]]></textFieldExpression>
            </textField>
            <textField pattern="R$ #,##0.00">
                <reportElement style="Total" x="390" y="0" width="80" height="22" forecolor="#E8A317"/>
                <box rightPadding="6"/>
                <textElement textAlignment="Right" verticalAlignment="Middle"/>
                <textFieldExpression><![CDATA[$V{TOTAL_RECEITA}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement style="Total" x="470" y="0" width="65" height="22"/>
                <box rightPadding="6"/>
                <textElement textAlignment="Right" verticalAlignment="Middle"/>
                <textFieldExpression><![CDATA[$V{TOTAL_RECEITA}.signum() > 0 ? "100%" : "–"]]></textFieldExpression>
            </textField>

            <!-- Indicadores em texto: o que o gerente deve olhar primeiro -->
            <textField>
                <reportElement x="0" y="30" width="535" height="16" forecolor="#123B2E">
                    <printWhenExpression><![CDATA[$V{TOTAL_QTD}.signum() > 0]]></printWhenExpression>
                </reportElement>
                <textElement><font isBold="true"/></textElement>
                <textFieldExpression><![CDATA["Campeão de vendas: " + $V{CAMPEAO}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="0" y="46" width="535" height="16" forecolor="#C4341F">
                    <printWhenExpression><![CDATA[$V{SEM_VENDA} > 0]]></printWhenExpression>
                </reportElement>
                <textElement><font isBold="true"/></textElement>
                <textFieldExpression><![CDATA[$V{SEM_VENDA} + ($V{SEM_VENDA} == 1 ? " prato não vendeu" : " pratos não venderam")
    + " nenhuma unidade no período: avalie promoção ou retirada do cardápio."]]></textFieldExpression>
            </textField>

            <!-- Barras deitadas: o nome do prato cabe melhor na vertical -->
            <barChart>
                <chart isShowLegend="false" evaluationTime="Report">
                    <reportElement x="0" y="70" width="535" height="266">
                        <printWhenExpression><![CDATA[$V{TOTAL_QTD}.signum() > 0]]></printWhenExpression>
                    </reportElement>
                    <chartTitle color="#123B2E">
                        <font size="11" isBold="true"/>
                        <titleExpression><![CDATA["Unidades vendidas por prato"]]></titleExpression>
                    </chartTitle>
                    <chartSubtitle/>
                    <chartLegend/>
                </chart>
                <categoryDataset>
                    <categorySeries>
                        <seriesExpression><![CDATA["Vendidos"]]></seriesExpression>
                        <categoryExpression><![CDATA[$F{prato}]]></categoryExpression>
                        <valueExpression><![CDATA[$F{quantidade}]]></valueExpression>
                    </categorySeries>
                </categoryDataset>
                <barPlot isShowTickMarks="false">
                    <plot backcolor="#FBF9F4" orientation="Horizontal">
                        <seriesColor seriesOrder="0" color="#123B2E"/>
                    </plot>
                    <itemLabel/>
                    <categoryAxisFormat>
                        <axisFormat>
                            <tickLabelFont><font size="7"/></tickLabelFont>
                        </axisFormat>
                    </categoryAxisFormat>
                    <valueAxisFormat>
                        <axisFormat tickLabelMask="#,##0">
                            <tickLabelFont><font size="7"/></tickLabelFont>
                        </axisFormat>
                    </valueAxisFormat>
                </barPlot>
            </barChart>
        </band>
    </summary>
</jasperReport>
